{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "astro.config.mjs",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "content",
    ".agents",
    ".claude",
    ".cursor",
    ".gemini",
    ".grok",
    ".hermes",
    ".opencode",
    ".pi",
    ".impeccable",
    "playwright-report",
    "test-results",
    "public",
    ".cache"
  ]
}
